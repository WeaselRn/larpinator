# ============================== Groq (AI) ===================================
# Server-side only. Get a key at https://console.groq.com
GROQ_API_KEY=
# Optional: override the default model (default: openai/gpt-oss-120b)
# GROQ_MODEL=
# Optional: only set if your Groq account has a vision model.
# Enables image (screenshot) CV uploads. Without it, use PDF or pasted text.
# GROQ_VISION_MODEL=

# ================================ GitHub ====================================
# Personal access token with public read access (server-side only).
GITHUB_TOKEN=

# =============================== Last.fm ====================================
# API key from https://www.last.fm/api/account/create (server-side only).
LASTFM_API_KEY=

# ================================ Clerk =====================================
# https://dashboard.clerk.com → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# =============================== Supabase ===================================
# https://supabase.com/dashboard → Project Settings → API keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret / service-role key. Server-side only — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ============================ Python PDF service ============================
# Where the PyMuPDF extraction service runs (see pdf-service/).
PDF_SERVICE_URL=http://localhost:8000

# ----------------------------------------------------------------------------
# Note: the app also accepts the legacy variable names used in some setups:
#   GROQ  (instead of GROQ_API_KEY)
#   LASTFM_API  (instead of LASTFM_API_KEY)
# ----------------------------------------------------------------------------
